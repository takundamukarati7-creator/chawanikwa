# Copy this file to .env (Copy-Item .env.example .env) and edit the values.
# NEVER commit .env to git.

# Development: 1.  Production: 0
DJANGO_DEBUG=1

# Development can leave this empty. Production MUST set a long random value (50+ chars).
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Comma-separated. Production example: foundit.example.co.zw,www.foundit.example.co.zw
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production only (include https://): https://foundit.example.co.zw
CSRF_TRUSTED_ORIGINS=

# Empty = local SQLite file. Production example:
# DATABASE_URL=postgres://foundit_user:STRONG_PASSWORD@127.0.0.1:5432/foundit
DATABASE_URL=

# Set to 1 only when Nginx (or another trusted proxy) sits in front of Gunicorn.
TRUST_PROXY=0

# Optional: Redis for rate-limit counters shared across workers
# REDIS_URL=redis://127.0.0.1:6379/1

# Path to the staff dashboard's Django admin (keep it non-obvious in production)
DJANGO_ADMIN_URL=admin/

# Data retention (days)
RETENTION_DAYS_FOUND=90
RETENTION_DAYS_LOST=180
RETENTION_DAYS_AUDIT=365

# Shown in the footer and on the privacy page
SITE_CONTACT_EMAIL=
SITE_CONTACT_PHONE=
