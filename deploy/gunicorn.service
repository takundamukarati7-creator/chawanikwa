# /etc/systemd/system/foundit.service
[Unit]
Description=Chawanikwa Found It (Gunicorn)
After=network.target postgresql.service

[Service]
User=foundit
Group=www-data
WorkingDirectory=/srv/foundit/app
EnvironmentFile=/etc/foundit.env
ExecStart=/srv/foundit/venv/bin/gunicorn config.wsgi:application \
  --bind unix:/run/foundit/gunicorn.sock --workers 3 --timeout 30 \
  --access-logfile - --error-logfile -
RuntimeDirectory=foundit
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
